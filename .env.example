# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# You can also configure or update your Gemini API key in the AI Studio Settings / Secrets panel.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

PORT=3000
JWT_SECRET=
MONGO_URI=
AI_MODEL=gemini-2.5-flash
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
VITE_API_URL=
